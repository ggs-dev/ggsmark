{
  "name": "ggsmark",
  "version": "0.10.4",
  "type": "module",
  "description": "Markdown extension for the Gentlemen's Gaming Society website.",
  "repository": "https://github.com/johnnyhuy/ggsmark.git",
  "author": "Johnny Huynh <info@johnnyhuy.com>",
  "license": "MIT",
  "dependencies": {
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-color-text": "^0.4.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-spoilers": "^0.5.2",
    "remark-text-alignment": "^0.5.12",
    "unified": "^11.0.5"
  },
  "main": "dist/index.js",
  "browser": "dist/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "cross-env BABEL_ENV=production babel src --config-file ../../babel.config.cjs --ignore \"**/*.spec.js,**/*.test.js\" --out-dir dist"
  }
}
