{
  "name": "ggsmark-monorepo",
  "private": true,
  "type": "module",
  "repository": "https://github.com/johnnyhuy/ggsmark.git",
  "author": "Johnny Huynh <info@johnnyhuy.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "postinstall": "npm run build --workspaces --if-present",
    "prepublishOnly": "npm run build",
    "pretest": "npm run lint && npm run build",
    "format": "prettier \"packages/**/*.js\" --write",
    "lint": "eslint \"packages/**/*.js\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "release": "lerna version --create-release github --conventional-commits --yes && lerna publish from-package --yes"
  },
  "overrides": {
    "nx": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "cross-env": "^10.1.0",
    "dedent": "^1.7.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "lerna": "^10.1.1",
    "prettier": "^3.9.10",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  }
}
